{
  "name": "node-fibonacci-service",
  "version": "1.0.0",
  "description": "A REST API that generates arbitrarily large fibonacci numbers.",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "start-big": "node --max-old-space-size=32000 ./bin/www",
    "repl-big": "node --max-old-space-size=32000"
  },
  "dependencies": {
    "express": "^4.17.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/big-integer": "0.0.30"
  },
  "engines": {
    "node": ">=10.4.0"
  }
}
