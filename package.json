{
  "name": "node-fibonacci-service",
  "version": "1.0.0",
  "description": "A REST API that generates arbitrarily large fibonacci numbers.",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "start-big": "node ---max-semi-space-size=2048 --max-old-space-size=4096 ./bin/www",
    "repl-big": "node --max-semi-space-size=2048 --max-old-space-size=4096",
    "one-off": "node --max-semi-space-size=2048 --max-old-space-size=4096 run.js",
    "clean-cache": "echo \"Cache purge: Hope you're sure!\" && sleep 10 && find .cache -type f -mmin +120 -delete"
  },
  "dependencies": {
    "config": "^4.0.0",
    "express": "^4.17.1",
    "mysql2": "^3.14.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/config": "^3.3.5"
  }
}
