{
  "name": "node-fibonacci-service",
  "version": "1.0.0",
  "description": "A REST API that generates arbitrarily large fibonacci numbers.",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "start-big": "node --max-old-space-size=16000 ./bin/www",
    "repl-big": "node --max-old-space-size=16000",
    "one-off": "node --max-old-space-size=2000 run.js"
  },
  "dependencies": {
    "express": "^4.17.1",
    "mysql2": "^3.14.1"
  },
  "engines": {
    "node": ">=18"
  }
}
